{
  "name": "proctoring-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm start --workspace=server",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client -- --host\"",
    "dev:demo": "ALLOW_MISSING_SUPABASE=true concurrently \"npm run dev:demo --workspace=server\" \"npm run dev --workspace=client -- --host\"",
    "convex:deploy": "npx convex deploy",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "concurrently": "^8.2.2",
    "playwright": "^1.57.0"
  },
  "dependencies": {
    "convex": "^1.31.0",
    "socket.io-client": "^4.8.1"
  }
}