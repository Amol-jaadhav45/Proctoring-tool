# ===========================================
# Proctoring System – Deployment Environment
# ===========================================
# Copy to .env and fill in values.
# Convex: set in Convex Dashboard (dashboard.convex.dev)
# Client: set VITE_* at build time

# --- Convex (required) ---
# From: npx convex dev or npx convex deploy
CONVEX_DEPLOYMENT=dev:your-deployment
CONVEX_URL=

# --- Client (build-time, VITE_ prefix) ---
VITE_CONVEX_URL=
# Backend API URL (for production, use full URL; dev uses proxy)
VITE_API_URL=
VITE_SOCKET_URL=

# --- Server ---
PORT=4000
NODE_ENV=production
# Comma-separated origins for CORS (or * for dev)
CORS_ORIGIN=

# --- Convex Actions: Invite Emails (Resend) ---
# Set in Convex Dashboard > Settings > Environment Variables
# RESEND_API_KEY=re_xxx
# FROM_EMAIL=ProctorAI <noreply@yourdomain.com>

# --- Optional: Redis (event bus) ---
# REDIS_URL=redis://localhost:6379

# --- Optional: Supabase ---
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# --- Optional: MediaSoup (WebRTC) ---
# MEDIASOUP_MIN_PORT=10000
# MEDIASOUP_MAX_PORT=10100
# MEDIASOUP_LISTEN_IP=0.0.0.0
# MEDIASOUP_ANNOUNCED_IP=
